{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "cbor2": [
        "./node_modules/cbor2/lib/index.d.ts"
      ],
      "cbor2/*": [
        "./node_modules/cbor2/lib/*.d.ts"
      ],
      "@ipld/dag-cbor": [
        "./node_modules/@ipld/dag-cbor/dist/src/index.d.ts"
      ],
      "cborg": [
        "./node_modules/cborg/types/cborg.d.ts"
      ],
      "@bsv/sdk": [
        "./node_modules/@bsv/sdk/dist/types/mod.d.ts"
      ],
      "@bsv/sdk/*": [
        "./node_modules/@bsv/sdk/dist/types/src/*.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
